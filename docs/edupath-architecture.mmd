%% EduPath actual architecture
%% Documentation-only diagram. Gemini credentials remain server-side.
flowchart TB
    Learner["👤 LEARNER"]

    subgraph Frontend["Frontend · React + Vite"]
        UI["React Frontend<br/>EduPath UI"]
    end

    subgraph Backend["Backend · Node.js + Express"]
        API["Express Backend<br/>REST API"]
        Routes["Profile routes<br/>/api/profiles/*"]
        API --> Routes
    end

    subgraph Services["AI Services · @google/genai"]
        Gap["🧠 Skill Gap Agent<br/><small>Identifies missing skills</small>"]
        Planner["📚 Learning Planner<br/><small>Creates personalized roadmap</small>"]
        Progress["📊 Progress Agent<br/><small>Evaluates learner progress</small>"]
        Adaptive["🔄 Adaptive Agent<br/><small>Modifies future learning tasks</small>"]
    end

    subgraph Database["Database · MongoDB + Mongoose"]
        Profiles[("Learner Profile Data")]
    end

    Gemini["Google Gemini API<br/>AI reasoning"]

    Learner --> UI
    UI --> API
    Routes --> Gap
    Routes --> Planner
    Routes --> Progress
    Routes --> Adaptive
    Routes --> Profiles
    Gap --> Gemini
    Planner --> Gemini
    Progress --> Gemini
    Adaptive --> Gemini

    Security["🔒 Security boundary<br/>GEMINI_API_KEY remains server-side"]
    UI -. "No API key" .-> Security
    Security -. "Backend-only access" .-> Gemini

    subgraph Workflow["Agentic learning workflow · iterative"]
        Profile["👤 Profile"] --> SkillGap["🧠 Skill Gap Agent"]
        SkillGap --> LearningPlan["📚 Learning Planner"]
        LearningPlan --> Roadmap["🗓️ Personalized Roadmap"]
        Roadmap --> Tasks["☑️ Task Completion"]
        Tasks --> ProgressReview["📊 Progress Agent"]
        ProgressReview --> Adapt["🔄 Adaptive Agent"]
        Adapt --> Updated["✏️ Updated Roadmap"]
        Updated -. "↺ Continue learning" .-> Tasks
    end

    classDef app fill:#edf3ff,stroke:#2764e7,color:#172033,stroke-width:1.5px
    classDef backend fill:#e8f7f5,stroke:#0d9488,color:#172033,stroke-width:1.5px
    classDef agent fill:#fff7e6,stroke:#b7791f,color:#172033,stroke-width:1.5px
    classDef data fill:#f1f5f9,stroke:#64748b,color:#172033,stroke-width:1.5px
    classDef security fill:#fff6f5,stroke:#b42318,color:#7f1d1d,stroke-width:1.5px
    classDef workflow fill:#ffffff,stroke:#94a3b8,color:#172033,stroke-width:1.5px

    class UI app
    class API,Routes backend
    class Gap,Planner,Progress,Adaptive,Gemini agent
    class Profiles data
    class Security security
    class Profile,SkillGap,LearningPlan,Roadmap,Tasks,ProgressReview,Adapt,Updated workflow
